# ---- Alibaba Cloud Model Studio (DashScope) ----------------------------
# Get a key: https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=your_api_key_here
# cn (Beijing, default) or intl (Singapore). Keys are region-specific!
# DASHSCOPE_REGION=cn
# Full host override (rarely needed)
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ---- OSS: needed to upload your own images for image / keyframe / reference tasks
# Without it the app silently uses a demo image.
# OSS_ACCESS_KEY_ID=your_oss_access_key_id
# OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET_NAME=your_bucket_name

# ---- Studio behaviour --------------------------------------------------
# Default model per task (any id from `python cli.py models --all`)
# WAN_DEFAULT_T2V_MODEL=wan3.0-video
# WAN_DEFAULT_I2V_MODEL=wan3.0-video
# WAN_DEFAULT_KF2V_MODEL=wan3.0-video
# WAN_DEFAULT_R2V_MODEL=wan3.0-video
# WAN_DEFAULT_IMAGE_MODEL=wan2.7-image-pro
# WAN_DEFAULT_IMAGE_EDIT_MODEL=qwen-image-3.0-pro
# WAN_DEFAULT_SPEECH_MODEL=qwen3-tts-flash
# Show Wan 2.2 / 2.5 (legacy) or Wan 2.1 (deprecated) models in the UI
# WAN_SHOW_LEGACY=0
# WAN_SHOW_DEPRECATED=0
# Preview payloads without calling the API
# WAN_DRY_RUN=0
# Where task history + downloaded videos live
# WAN_DATA_DIR=~/.wan_gateway
# WAN_HISTORY_LIMIT=50
# Qwen model behind the ✨ Enhance button
# WAN_PROMPT_OPTIMIZER_MODEL=qwen-plus

# ---- Server ------------------------------------------------------------
# PORT=7860
# HOST=0.0.0.0
